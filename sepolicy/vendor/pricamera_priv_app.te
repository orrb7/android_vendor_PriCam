allow priv_app unlabeled:filesystem getattr;
allow priv_app dmabuf_system_heap_device:chr_file { read write open ioctl };

# qemu_hw_prop read (ro.kernel.qemu.*)
allow priv_app qemu_hw_prop:file { read open getattr };

# BGService dari vendor camera
allow priv_app default_android_service:service_manager find;

# MTK camera HAL binder
allow priv_app mtk_hal_camera:binder { call transfer };

# MediaProvider
allow priv_app mediaprovider:binder { call transfer };
allow priv_app mediaprovider_app:binder { call transfer };
